# Bot Configuration
BOT_PREFIX=.
SESSION_NAME=session
LOG_LEVEL=info

# WhatsApp Auth Mode: 'qr' atau 'pairing'
AUTH_MODE=qr
# Nomor telepon untuk pairing code (format internasional tanpa +, contoh: 628123456789)
PAIRING_PHONE_NUMBER=

# Daftar nomor WhatsApp Admin (pisahkan dengan koma jika lebih dari satu, contoh: 628123456789,628987654321)
ADMIN_NUMBERS=

# Web Dashboard Configuration
WEB_PORT=3000
DASHBOARD_PASSWORD=admin123

# Welcome Message Grup
WELCOME_ENABLED=true
WELCOME_MESSAGE=Selamat datang @user! Ketik .menu untuk melihat menu bot.

# Anti-Spam Grup
ANTISPAM_ENABLED=false
ANTISPAM_MAX_MESSAGES=5
ANTISPAM_WINDOW_SECONDS=10
ANTISPAM_COOLDOWN_SECONDS=60

# Turso Database Configuration (libsql://... untuk cloud Turso, atau file:bot.db untuk SQLite lokal)
TURSO_DATABASE_URL=file:bot.db
TURSO_AUTH_TOKEN=
